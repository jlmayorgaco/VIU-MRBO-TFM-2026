% Convención visual de originalidad. Esta caja identifica una formulación o
% resultado producido en el TFM; no implica por sí sola prioridad universal,
% validez fuera de los supuestos declarados ni un nivel de evidencia superior
% al registrado en la matriz de afirmaciones.
\newtcolorbox{contribucion}[1]{%
  enhanced,
  breakable,
  colback=VIUOrange!4,
  colframe=VIUOrange,
  colbacktitle=VIUOrange!13,
  coltitle=VIUDark,
  title={#1},
  fonttitle=\bfseries,
  boxrule=0.45pt,
  leftrule=2.8pt,
  arc=1.2mm,
  outer arc=1.2mm,
  left=2.5mm,
  right=2.5mm,
  top=1.5mm,
  bottom=1.5mm,
  before skip=8pt plus 2pt,
  after skip=8pt plus 2pt
}

% Toda caja de aporte debe declarar la fuerza real de la evidencia. La marca
% visual identifica autoría dentro del TFM, no prioridad universal.
\newcommand{\estadoaporte}[1]{%
  \textbf{Resultado y alcance:} #1\par\smallskip
}

