% Los diagramas SP usan exactamente los 15 cm del cuerpo VIU. El marco se
% dibuja medio trazo hacia dentro para que su borde exterior coincida con
% \linewidth, y la escala vertical aporta espacio real entre elementos.
\newenvironment{spdiagram}{%
  \pgfmathsetlengthmacro{\spxunit}{\linewidth/13.5}%
  \begin{tikzpicture}[x=\spxunit,y=1.00cm]%
}{%
  \end{tikzpicture}%
}
\newcommand{\spdrawarena}[1]{%
  \fill[SPFloor] (0.012,0.75) rectangle (13.488,5.25);%
  \draw[spgrid,step=0.5] (0.012,0.75) grid (13.488,4.65);%
  \fill[white] (0.012,4.65) rectangle (13.488,5.25);%
  \draw[draw=SPGrid,line width=0.55pt] (0.012,4.65) -- (13.488,4.65);%
  \draw[sparena] (0.012,0.75) rectangle (13.488,5.25);%
  \node[sptitle,anchor=west] at (0.20,4.95) {#1};%
  \draw[splegendbox] (0.012,0.08) rectangle (13.488,0.60);%
}

