# Generated results
results/raw/*
!results/raw/.gitkeep
results/processed/*
!results/processed/.gitkeep
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep
results/reports/*
!results/reports/.gitkeep
results/batch/*
