# Mutable smoke-test outputs are regenerated by pytest/submit-check and should
# not live in the canonical result set.
results/sp7/SP7_DEBUG_smoke/
results/sp8/SP8_DEBUG_smoke/

# Campaign artifacts: keep summaries, manifests, data and final plots; ignore
# bulky generated frame folders unless explicitly force-added.
results/campaigns/**/frames/*
!results/campaigns/**/frames/.gitkeep

# V6 organization quarantine / regenerated local artifacts
.claude/
archive/
guidelines/
output/
pytest-cache-files-*/
