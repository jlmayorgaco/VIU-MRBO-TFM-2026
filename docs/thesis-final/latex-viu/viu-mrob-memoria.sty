\newcommand{\makeviuwordcover}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=south west,inner sep=0] at (current page.south west)
        {\includegraphics[width=\paperwidth,height=\paperheight]{\viucoversource}};
      \node[anchor=north west,align=left,text width=0.82\paperwidth] at ($(current page.north west)+(2.55cm,-2.25cm)$) {%
        \raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
        {\bfseries\fontsize{12}{14}\selectfont \viumaster\par}
        \vspace{1.0cm}
        {\bfseries\fontsize{13}{16}\selectfont TÍTULO:\par}
        {\bfseries\fontsize{13}{16}\selectfont \viutitle\par}
        \vspace{0.45cm}
        {\fontsize{12}{15}\selectfont Alumno/a: \viustudent\par}
        \vspace{0.20cm}
        {\fontsize{12}{15}\selectfont Director/a: \viututor\par}
        \vspace{0.20cm}
        {\fontsize{12}{15}\selectfont Edición: \viuedition\par}
        {\fontsize{12}{15}\selectfont Fecha: \viudate\par}
      };
    \end{tikzpicture}
    \vspace*{\fill}
  \end{titlepage}
}

