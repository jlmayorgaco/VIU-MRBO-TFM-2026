%==============================================================================
% PORTADA VIU (replica TikZ del Word template)
%
% Layout:
%   - Fondo naranja VIU (#E65113) a sangre completa
%   - Forma blanca de "rin/judia" en el lado derecho, con curva concava
%     hacia la izquierda que bulto en el centro vertical
%   - Logo VIU (blob naranja con "viu" blanco) + lockup "Universidad
%     Internacional de Valencia" dentro de la zona blanca
%   - Pie inferior: "De: Planeta Formacion y Universidades"
%   - Texto blanco del TFM (titulo, alumno, tutor, edicion) sobre la
%     zona naranja izquierda
%==============================================================================
\newcommand{\makeviucover}{%
  \begin{titlepage}
    \thispagestyle{viucover}
    \null
    \begin{tikzpicture}[remember picture, overlay]
      %----------------------------------------------------------------
      % FONDO: imagen oficial de la portada VIU (replica pixel-perfect)
      %----------------------------------------------------------------
      \node[anchor=center, inner sep=0pt] at (current page.center) {%
        \includegraphics[width=\paperwidth, height=\paperheight, keepaspectratio=false]
          {images/viu_cover_bg.jpg}%
      };

      %----------------------------------------------------------------
      % NOMBRE DEL MASTER: dentro del ovalo blanco, 3 lineas
      % Coordenadas Word: parrafo 5, 18pt, right-aligned.
      % Usamos 3 nodos separados para control exacto sin riesgo de
      % hyphenation o wrap automatico.
      %----------------------------------------------------------------
      % Desplazado 2em (~ 0.7cm) a la izquierda respecto al ancla anterior
      \node[anchor=base east, text=black,
            font={\fontsize{18}{18}\selectfont}]
        at ($(current page.north east)+(-4.4cm,-7.5cm)$)
        {M\'ASTER UNIVERSITARIO EN};
      \node[anchor=base east, text=black,
            font={\fontsize{18}{18}\selectfont}]
        at ($(current page.north east)+(-4.4cm,-8.4cm)$)
        {ROB\'OTICA Y AUTOMATIZACI\'ON DE};
      \node[anchor=base east, text=black,
            font={\fontsize{18}{18}\selectfont}]
        at ($(current page.north east)+(-4.4cm,-9.3cm)$)
        {PROCESOS};

      %----------------------------------------------------------------
      % TITULO: label en y=19cm (igual que el Word), valor debajo de la
      % curva blanca (y=22cm) con ancho completo. Esto evita que titulos
      % largos invadan la zona blanca.
      %----------------------------------------------------------------
      \node[anchor=north west, text=white, align=left,
            font={\fontsize{18}{22}\selectfont}]
        at ($(current page.north west)+(3.0cm,-18.5cm)$)
        {T\'ITULO:};
      \node[anchor=north west, text=white, align=left, text width=15cm,
            font={\bfseries\fontsize{12}{15}\selectfont}]
        at ($(current page.north west)+(3.0cm,-21.5cm)$)
        {\viutitle};

      %----------------------------------------------------------------
      % ALUMNO/A
      %----------------------------------------------------------------
      \node[anchor=north west, text=white, align=left,
            font={\fontsize{18}{22}\selectfont}]
        at ($(current page.north west)+(3.0cm,-23.5cm)$)
        {Alumno/a:};
      \node[anchor=north west, text=white, align=left, text width=15cm,
            font={\fontsize{12}{15}\selectfont}]
        at ($(current page.north west)+(3.0cm,-24.6cm)$)
        {\viustudent};

      %----------------------------------------------------------------
      % DIRECTOR/A
      %----------------------------------------------------------------
      \node[anchor=north west, text=white, align=left,
            font={\fontsize{18}{22}\selectfont}]
        at ($(current page.north west)+(3.0cm,-26.0cm)$)
        {Director/a:};
      \node[anchor=north west, text=white, align=left, text width=15cm,
            font={\fontsize{12}{15}\selectfont}]
        at ($(current page.north west)+(3.0cm,-27.1cm)$)
        {\viututor};
    \end{tikzpicture}
  \end{titlepage}
}

