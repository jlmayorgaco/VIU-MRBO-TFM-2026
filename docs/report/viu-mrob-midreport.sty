%==============================================================================
% Estilos de seccion (replica de Heading1/Heading2 del template VIU Word)
%  - Heading 1: Arial 18pt bold, color #E65113, numerado "1."
%  - Heading 2: Arial 16pt, color #E65113, numerado "1.1."
%  - Heading 3: 14pt bold (no definido en Word, lo extrapolamos coherentemente)
%==============================================================================
% El numero de cada encabezado hereda el tamano del titulo (mismo \fontsize):
% el segundo argumento ya no fuerza un tamano menor.
\titleformat{\section}[hang]
  {\sffamily\bfseries\color{VIUOrange}\fontsize{18}{22}\selectfont}
  {\thesection.}
  {0.45em}{}
\titleformat{\subsection}[hang]
  {\sffamily\color{VIUOrange}\fontsize{16}{20}\selectfont}
  {\thesubsection.}
  {0.40em}{}
\titleformat{\subsubsection}[hang]
  {\sffamily\bfseries\color{VIUOrange}\fontsize{14}{18}\selectfont}
  {\thesubsubsection.}
  {0.35em}{}
\titleformat{\paragraph}[runin]
  {\sffamily\bfseries\color{VIUDark}\normalsize}
  {}{0pt}{}
\titlespacing*{\section}{2.5em}{1.6em}{0.6em}
\titlespacing*{\subsection}{2.5em}{1.1em}{0.4em}
\titlespacing*{\subsubsection}{2.5em}{0.8em}{0.3em}
\titlespacing*{\paragraph}{0pt}{0.6em}{0.5em}

