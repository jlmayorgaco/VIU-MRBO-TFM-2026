\renewcommand{\cftsecfont}{\sffamily\color{VIUDark}}
\renewcommand{\cftsecpagefont}{\sffamily\color{VIUDark}}
\renewcommand{\cftsubsecfont}{\sffamily\color{VIUDark}}
\renewcommand{\cftsubsecpagefont}{\sffamily\color{VIUDark}}
