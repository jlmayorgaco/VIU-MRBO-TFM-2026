% Indice de figuras / tablas: "Figura N." y "Tabla N." en bold seguido del
% caption con un unico espacio. Entradas alineadas al margen izquierdo (mismo
% inicio que el titulo "Indice de figuras"): cftXindent = 0.
\renewcommand{\cftfigpagefont}{\sffamily\color{VIUDark}}
\renewcommand{\cfttabpagefont}{\sffamily\color{VIUDark}}
\setlength{\cftfigindent}{0pt}
\setlength{\cfttabindent}{0pt}

% Override total del layout de entrada de LOF/LOT: "Figura N. Descripcion ..."
% en una unica linea de texto fluido (sin columna fija para el numero), de
% modo que la descripcion empieza con un unico espacio despues del numero.
% "Figura" / "Tabla" se inyectan dentro de \numberline para que queden
% dentro del area clickeable de hyperref (toda la linea es un link).
\makeatletter
\renewcommand{\l@figure}[2]{%
  \par\addvspace{2pt}%
  \begingroup
    \parindent 0pt
    \leftskip  0pt
    \rightskip 2.55em
    \parfillskip -\rightskip
    \sffamily\color{VIUDark}\interlinepenalty\@M
    \leavevmode
    \def\numberline##1{\bfseries Figura\nobreakspace##1.\space\normalfont\color{VIUDark}}%
    #1%
    \nobreak
    \cftdotfill{\cftdotsep}%
    \nobreak\hb@xt@2.55em{\hfil\normalfont\sffamily\color{VIUDark}#2}%
    \par
  \endgroup
}
\renewcommand{\l@table}[2]{%
  \par\addvspace{2pt}%
  \begingroup
    \parindent 0pt
    \leftskip  0pt
    \rightskip 2.55em
    \parfillskip -\rightskip
    \sffamily\color{VIUDark}\interlinepenalty\@M
    \leavevmode
    \def\numberline##1{\bfseries Tabla\nobreakspace##1.\space\normalfont\color{VIUDark}}%
    #1%
    \nobreak
    \cftdotfill{\cftdotsep}%
    \nobreak\hb@xt@2.55em{\hfil\normalfont\sffamily\color{VIUDark}#2}%
    \par
  \endgroup
}
\makeatother

