%==============================================================================
% Espaciado tipografico (replica VIU: 1.5 lineas, 6pt despues, justificado)
% Word interpreta "1.5 lines" como 1.5 x el baselineskip base (14.4pt para
% 12pt) = 21.6pt entre lineas. setspace's \onehalfspacing en clase 12pt da
% solo ~18pt, dejando la version mas compacta que Word. Usamos \linespread
% para forzar la interpretacion literal de Word.
%==============================================================================
\linespread{1.5}                   % Baseline-to-baseline 21.6pt (= Word)
\setlength{\parindent}{0pt}        % Sin sangria de primera linea
\setlength{\parskip}{6pt plus 1pt} % 6pt despues de cada parrafo (= w:after 120)
\sloppy                            % Justificacion mas tolerante

